# FlowBoard Environment Variables
# Copy this file to .env and fill in real values for production use.

# Set to false to use real Cerner API instead of mock data
VITE_MOCK_MODE=true

# Cerner FHIR base URL (SMART on FHIR R4 endpoint)
# Example: https://fhir.cerner.com/r4/ec2458f2-1e24-41c8-b71b-0e701af7583d
VITE_CERNER_BASE_URL=https://fhir.cerner.com/r4/YOUR_TENANT_ID

# Cerner SMART on FHIR client ID (registered in Cerner Code Console)
VITE_CERNER_CLIENT_ID=

# FlowBoard AI agent endpoint
# This should be a backend URL that proxies to your LLM provider
VITE_AI_AGENT_URL=

# Demo login credentials (set these in Vercel env vars for the exec demo)
# If both are unset, the login gate is bypassed (useful for local dev)
VITE_DEMO_EMAIL=demo@example.com
VITE_DEMO_PASSWORD=your-password-here
